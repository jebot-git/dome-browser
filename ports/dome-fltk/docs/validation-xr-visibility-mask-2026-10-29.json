{
  "change": "Add WebXR visibility-mask events and coherent per-view provider updates",
  "base_commit": "e485d779fd319af65e60d432f7943e13ab1a273b",
  "behavior": [
    "Expose the standard visibility-mask event constructor, session handler and typed-array getters",
    "Preserve constructor array identity and SameObject semantics; provider events own independent geometry snapshots",
    "Deliver mask updates with the active frame view list and per-session secondary-view grants",
    "Use empty geometry to clear a previous mask and avoid updates for nonexistent view slots",
    "Suppress duplicate unchanged-frame events and avoid copying geometry every frame",
    "Keep ended-session and sensor-free inline behavior consistent with their lifecycle"
  ],
  "provider_scope": "Generic frame-update API and headless provider implemented. Existing physical DomeD providers report no masks and retain full-view rendering; no hardware mask geometry is fabricated.",
